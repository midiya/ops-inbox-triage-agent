# Copy to .env and fill in real values.
# .env is gitignored; this file is committed and must only ever hold placeholders.

# --- required ------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- model and limits (optional; defaults shown) --------------------------
TRIAGE_MODEL=gpt-4o-mini
SOFT_INPUT_CHARS=2000      # over this: still classify, but force human review
MAX_INPUT_CHARS=8000       # over this: refuse before spending an API call
MAX_OUTPUT_TOKENS=800      # measured real usage is 55-83; this is a runaway guard

# --- Jira (optional) -----------------------------------------------------
# Leave blank to run classification and routing without filing anything.
# Create a token at id.atlassian.com -> Security -> API tokens.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_TIMEOUT=20

# Set to true only if your Jira project has time tracking switched on
# (Project settings -> Features -> Time tracking). When true, a stated estimate
# is written to the Original estimate field as well as the description.
# Leave it false if you are unsure: sending the field to a project that does not
# have it makes Jira reject the whole issue.
JIRA_SUPPORTS_TIMETRACKING=false

# --- HTTP service (service.py) -------------------------------------------
# true = classify and route but never create a real issue. Default is true:
# a service whose default action writes to a real system is one you cannot
# safely restart while debugging.
TRIAGE_MOCK=true

# Shared secret every caller of /triage must send as an X-Triage-Token header.
# REQUIRED: with this unset the endpoint refuses every request, rather than
# serving an open door that spends your OpenAI credit. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIAGE_SHARED_TOKEN=

# Spend ceiling, enforced regardless of who is calling. This covers the case a
# token cannot: a stuck retry loop holding valid credentials.
TRIAGE_MAX_PER_MINUTE=10
TRIAGE_MAX_PER_DAY=200
