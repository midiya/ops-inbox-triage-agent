# --- secrets -------------------------------------------------------------
# Never commit real credentials. .env.example is the committed template and
# must only ever contain placeholders.
.env
.env.*
!.env.example

# --- runtime state -------------------------------------------------------
# Generated by running the tool, not source. They also contain real data:
# dead_letter.jsonl stores the full text of failed tickets, and
# processed.jsonl stores source ids (for Telegram that includes a chat id).
dead_letter.jsonl
processed.jsonl
*.log

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- editors / os --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
